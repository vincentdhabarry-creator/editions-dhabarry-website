# Clé secrète Stripe (Développeurs > Clés API sur dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_...

# Signature du webhook Stripe (créée après avoir déclaré l'endpoint /api/webhook sur Stripe)
STRIPE_WEBHOOK_SECRET=whsec_...

# Clé API Resend (resend.com > API Keys)
RESEND_API_KEY=re_...

# Adresse d'expédition des emails (doit venir d'un domaine vérifié sur Resend en production)
FROM_EMAIL=Editions Dhabarry <commandes@editionsdhabarry.com>

# URL publique du site (utilisée pour les redirections Stripe après paiement)
SITE_URL=https://editionsdhabarry.vercel.app

# Secret utilisé pour signer les liens de téléchargement (durée limitée à 72h).
# Génère une valeur aléatoire unique, par exemple avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Ne réutilise jamais cette valeur d'exemple.
DOWNLOAD_LINK_SECRET=remplace-moi-par-une-valeur-aleatoire

# Protection temporaire de la landing page (tant qu'elle n'est pas en vente).
# Laisse LANDING_PREVIEW_PASSWORD vide/absente pour désactiver la protection.
LANDING_PREVIEW_USER=dhabarry
LANDING_PREVIEW_PASSWORD=
