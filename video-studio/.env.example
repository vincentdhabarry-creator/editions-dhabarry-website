# --- LLM Script & Storyboard Generator ---
# Fournisseur utilisé pour générer le JSON du storyboard : "openai" | "anthropic" | "openrouter"
LLM_PROVIDER=openai

# Clé API du fournisseur choisi ci-dessus.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-...

# Modèle à utiliser (doit supporter les sorties structurées / tool use strict).
LLM_MODEL=gpt-4o-2024-08-06

# --- ElevenLabs (synthèse vocale + timestamps mot-à-mot) ---
ELEVENLABS_API_KEY=...
# IDs de voix ElevenLabs par défaut (homme dynamique, femme dynamique).
ELEVENLABS_VOICE_ID_MALE=pNInz6obpgDQGcFmaJgB
ELEVENLABS_VOICE_ID_FEMALE=21m00Tcm4TlvDq8ikWAM

# --- Rendu vidéo (Remotion) ---
# Dossier de sortie des rendus (chemin absolu ou relatif au projet).
RENDER_OUTPUT_DIR=out
